# Copier ce fichier en .env.local et renseigner les valeurs.

# --- Obligatoire -----------------------------------------------------------
# Clé de l'API Mistral : lecture des documents (OCR) et extraction des champs.
MISTRAL_API_KEY=votre_cle_mistral

# --- Protection de la démonstration ---------------------------------------
# Le mot de passe demandé à l'entrée : le seul à connaître et à communiquer.
# Laisser vide ou absent en développement local, l'accès est alors libre.
SOLIDIA_MOT_DE_PASSE=

# Clé de signature du ticket d'entrée. Personne ne la saisit jamais : après une
# connexion réussie, le serveur dépose un ticket dans le navigateur pour ne pas
# redemander le mot de passe à chaque page, et il le signe avec cette clé pour
# qu'on ne puisse pas en fabriquer un faux. Facultative (elle serait sinon
# dérivée du mot de passe), mais une valeur longue et aléatoire rend la
# signature indevinable. En générer une : openssl rand -hex 32
SOLIDIA_SECRET_SESSION=

# --- Facultatif ------------------------------------------------------------
# Modèles Mistral, si l'on veut s'écarter des valeurs par défaut.
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_CHAT_MODEL=mistral-small-latest
