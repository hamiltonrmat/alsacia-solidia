# Copier ce fichier en .env.local et renseigner les valeurs.

# --- Obligatoire -----------------------------------------------------------
# Clé de l'API Mistral : lecture des documents (OCR) et extraction des champs.
MISTRAL_API_KEY=votre_cle_mistral

# --- Protection de la démonstration ---------------------------------------
# Mot de passe unique demandé à l'entrée. Laisser vide ou absent en
# développement local : l'accès est alors libre. À renseigner sur Vercel.
SOLIDIA_MOT_DE_PASSE=

# Secret de signature du cookie de session. Facultatif : s'il est absent, il
# est dérivé du mot de passe. En recommander un long et aléatoire en ligne,
# par exemple le résultat de : openssl rand -hex 32
SOLIDIA_SECRET_SESSION=

# --- Facultatif ------------------------------------------------------------
# Modèles Mistral, si l'on veut s'écarter des valeurs par défaut.
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_CHAT_MODEL=mistral-small-latest
